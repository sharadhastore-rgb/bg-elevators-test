# Use the SAME database URI as the root .env.
MONGODB_URI=mongodb://127.0.0.1:27017/bg_elevators_cms
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# Only used by npm run admin:create. Remove ADMIN_PASSWORD after setup.
ADMIN_NAME=Primary Administrator
ADMIN_EMAIL=admin@bgelevators.com
ADMIN_PASSWORD=replace-before-running-create-admin

# Public website origin for "View published article". Set before admin build.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:5173
