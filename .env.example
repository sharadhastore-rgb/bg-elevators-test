# Shared by the public website/API and the admin CMS. Never commit real credentials.
PORT=5000
SITE_URL=https://www.bgelevators.com
TRUST_PROXY=0

# Database
MONGODB_DB=bg_elevators_cms
DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_URI=mongodb://127.0.0.1:27017/bg_elevators_cms

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# The mailbox used to send notification and customer confirmation emails.
SMTP_USER=
# Use the SMTP provider's app password/token, not a regular mailbox password.
SMTP_PASSWORD=
# Verified sender address/name, for example: BG Elevators <forms@example.com>
SMTP_FROM=
# Inbox for website leads and brochure requests; customers submit their email in the form.
ENQUIRY_TO=bgelevators@gmail.com
# Inbox for career applications. Falls back to ENQUIRY_TO when empty.
CAREERS_TO=bgelevators@gmail.com
# Admin CMS
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# Only used by npm run admin:create. Remove ADMIN_PASSWORD after setup if desired.
ADMIN_NAME=Primary Administrator
ADMIN_EMAIL=admin@bgelevators.com
ADMIN_PASSWORD=replace-before-running-create-admin
NEXT_PUBLIC_WEBSITE_URL=https://www.bgelevators.com

# ImageKit (server-side estimator image uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional analytics
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=
